# Desenvolvimento local sem Docker (recomendado):
#   npm run db:dev        -> sobe um Postgres local (via Prisma) e imprime a DATABASE_URL/SHADOW_DATABASE_URL
#   copie os valores impressos para as duas variáveis abaixo
#
# Produção / Docker (docker-compose.yml na raiz do projeto):
#   DATABASE_URL="postgresql://alpha:alpha@db:5432/alpha_platform?schema=public"

DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Auth (Auth.js / next-auth v5) — Google OAuth only, sessão JWT (sem tabelas de sessão no banco)
# AUTH_SECRET: gerar com `openssl rand -base64 32` ou `npx auth secret`
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: criar um OAuth Client ID em https://console.cloud.google.com/apis/credentials
#   com redirect URI <APP_URL>/api/auth/callback/google
# AUTH_URL: OBRIGATÓRIO em produção (Railway ou qualquer host atrás de proxy reverso) —
#   defina como a URL pública exata do app (ex.: https://alpha-hub-production-dd05.up.railway.app).
#   Sem isso o Auth.js tenta detectar o host pelos headers x-forwarded-host/host da requisição,
#   o que pode falhar dependendo do proxy e gerar um redirect_uri inválido rejeitado pelo Google
#   ("doesn't comply with Google's OAuth 2.0 policy"). Não precisa em dev local (localhost detecta bem).
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL=""

# Importação de contrato D4Sign (tela Novo Cliente)
# D4SIGN_API_TOKEN / D4SIGN_CRYPT_KEY: gerados no painel D4Sign (Configurações > Segurança > Tokens de API).
#   O D4Sign exige os dois juntos para autorizar o download do conteúdo de um documento.
# D4SIGN_BASE_URL: https://sandbox.d4sign.com.br/api/v1 (testes) ou https://secure.d4sign.com.br/api/v1 (produção,
#   usado por padrão se a variável ficar vazia)
D4SIGN_API_TOKEN=""
D4SIGN_CRYPT_KEY=""
D4SIGN_BASE_URL=""

# IA usada para interpretar o texto do contrato extraído (Claude, com Structured Outputs + Zod)
# ANTHROPIC_API_KEY: gerar em https://platform.claude.com
# ANTHROPIC_MODEL: opcional, usa "claude-opus-5" se ficar vazio
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
